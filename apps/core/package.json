{
  "name": "@homi/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config=src/auth.schema.ts --output=../../packages/db/src/schema/auth.generated.ts --yes",
    "start": "node dist/server.js",
    "bootstrap:first-account": "node dist/bootstrap-first-account.js",
    "module:install": "node dist/module-installer-cli.js install",
    "module:recover": "node dist/module-installer-cli.js recover",
    "module-platform:validate": "pnpm build && pnpm --filter @homi/module-template-starter build && node scripts/validate-module-installer.mjs",
    "module-directory:validate": "pnpm build && node scripts/validate-module-directory.mjs",
    "module-lifecycle:validate": "pnpm build && node scripts/validate-household-module-routes.mjs",
    "chequebook:validate": "pnpm build && pnpm --filter @homi/chequebook build && node scripts/validate-chequebook-01.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@homi/db": "workspace:*",
    "@homi/module-sdk": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "auth": "1.7.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
