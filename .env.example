# Server-only configuration. Never commit a real .env file.
# Generate each secret independently, for example: openssl rand -hex 32
HOMI_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-random-secret
HOMI_MIGRATOR_DB_PASSWORD=replace-with-random-secret
HOMI_APP_DB_PASSWORD=replace-with-random-secret
HOMI_JOBS_DB_PASSWORD=replace-with-random-secret
HOMI_BACKUP_DB_PASSWORD=replace-with-random-secret
HOMI_AUTH_SECRET=replace-with-random-secret
HOMI_MODULE_MANAGER_SECRET=replace-with-random-secret
HOMI_AUTH_BASE_URL=https://homi.example.com

# Optional host bindings. Defaults keep both HTTP services on loopback.
HOMI_BIND_ADDRESS=127.0.0.1
HOMI_WEB_PORT=3100
HOMI_CORE_PORT=3101

# Signed module directory. Leave blank until a directory is configured.
HOMI_MODULE_DIRECTORY_URL=
HOMI_MODULE_DIRECTORY_TRUSTED_KEYS=

# Optional. Required only for private GitHub release assets.
HOMI_GITHUB_TOKEN=
