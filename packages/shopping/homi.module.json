{
  "schemaVersion": 1,
  "moduleKey": "shopping",
  "name": "Shopping List",
  "publisher": "Homi",
  "version": "0.1.0",
  "moduleApiVersion": 1,
  "description": "A shared household shopping list with automatic aisle grouping, store and shopper assignments, offline use, and synchronized check-off.",
  "entrypoints": {
    "server": "./dist/server.js",
    "web": "./dist/web.js"
  },
  "database": {
    "schema": "mod_shopping",
    "migrations": "./migrations"
  },
  "coreCapabilities": ["household-people", "localization", "sync"],
  "requestedPermissions": ["household.read"],
  "navigation": [{
    "id": "shopping",
    "label": "Shopping List",
    "path": "/modules/shopping",
    "icon": "list"
  }],
  "setup": {
    "required": false,
    "scope": "household"
  },
  "settings": {
    "household": false,
    "user": false
  },
  "localization": {
    "defaultLocale": "en",
    "resources": "./locales"
  },
  "sync": {
    "entities": [{
      "entityType": "item",
      "operations": ["create", "update", "delete"]
    }]
  },
  "broker": {
    "provides": [],
    "consumes": []
  },
  "extensions": {
    "familyBoard": [{
      "surfaceId": "shopping-list",
      "label": "Shopping List",
      "slot": "noticeboard"
    }],
    "householdSettings": false,
    "notifications": false,
    "search": true
  }
}
