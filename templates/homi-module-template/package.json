{
  "name": "@homi/module-template-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "homi.module.json",
    "migrations",
    "locales"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "contract:validate": "pnpm manifest:validate && node scripts/validate-template.mjs"
  },
  "dependencies": {
    "@homi/module-sdk": "workspace:*",
    "@homi/ui": "workspace:*",
    "fastify": "5.12.4",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "esbuild": "0.25.10"
  }
}
